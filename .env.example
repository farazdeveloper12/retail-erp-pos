# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API). Never commit .env.local.

# Public values: safe to use in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secret: used only in src/lib/supabase/admin.ts.
# Never expose it to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# AI Assistant (server-only). Create a key at https://console.anthropic.com.
# Without it the AI Assistant page shows "not configured yet".
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: the Claude model to use. Leave empty for the default (claude-opus-5-5).
ANTHROPIC_MODEL=
